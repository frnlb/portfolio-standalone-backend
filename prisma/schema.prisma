generator client {
  provider = "prisma-client-js"
  output   = "./src/prisma/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model favorite_images {
  user_id      Int
  image_id     Int
  favorited_at DateTime? @default(now()) @db.DateTime(0)
  users        users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "favorite_images_ibfk_1")
  images       images    @relation(fields: [image_id], references: [image_id], onDelete: Cascade, onUpdate: NoAction, map: "favorite_images_ibfk_2")

  @@id([user_id, image_id])
  @@index([image_id], map: "image_id")
}

model images {
  image_id             Int               @id @default(autoincrement())
  filename             String            @unique(map: "filename") @db.VarChar(255)
  description          String?           @db.Text
  original_size_bytes  Int?
  optimized_size_bytes Int?
  file_path            String            @db.VarChar(512)
  upload_date          DateTime?         @default(now()) @db.DateTime(0)
  last_modified_date   DateTime?         @default(now()) @db.DateTime(0)
  location_id          Int?
  optimized_file_path  String?           @db.VarChar(255)
  favorite_images      favorite_images[]
  locations            locations?        @relation(fields: [location_id], references: [location_id], onDelete: NoAction, onUpdate: NoAction, map: "images_ibfk_1")

  @@index([location_id], map: "location_id")
}

model locations {
  location_id Int      @id @default(autoincrement())
  name        String   @unique(map: "name") @db.VarChar(255)
  description String?  @db.Text
  country     String?  @db.VarChar(255)
  region      String?  @db.VarChar(255)
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  images      images[]
}

model users {
  user_id         Int               @id @default(autoincrement())
  username        String?           @db.VarChar(255)
  email           String?           @db.VarChar(255)
  rights          users_rights      @default(reader)
  favorite_images favorite_images[]
}

enum users_rights {
  admin
  user
  reader
}
